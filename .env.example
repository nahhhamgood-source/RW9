# GEMINI_API_KEY: Server-side only Gemini API key for /api/analyze-food and /api/coach.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Gemini model overrides (defaults to gemini-3.1-flash-lite)
GEMINI_FOOD_MODEL="gemini-3.1-flash-lite"
GEMINI_COACH_MODEL="gemini-3.1-flash-lite"

# Optional server kill switch to disable all AI API endpoints ("true" disables AI calls)
DISABLE_AI_ENDPOINTS="false"

# Optional comma-separated extra allowed origins for CORS/same-origin checks
ALLOWED_ORIGINS=""

# Optional Web Push VAPID keys (leave empty to run local-notifications / .ics fallback only)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Secret token checked by Vercel Cron when invoking /api/send-reminders
CRON_SECRET=""

# APP_URL: Hosted URL used by deployment environment
APP_URL="MY_APP_URL"
